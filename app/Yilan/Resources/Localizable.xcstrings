    "%@\n其他文件不受影响，可以继续浏览。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nOther files aren’t affected. You can keep browsing."
          }
        }
      }
    },
    "%@ 影片" : {
      "comment" : "信息面板：视频格式名，%@ 是容器格式",
